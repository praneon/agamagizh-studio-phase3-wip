# Agamagizh Studio Environment Configuration
# Safe configuration variables only - NEVER place secrets, Meta tokens, or API keys here.

# Active provider mode: 'local' (isolated mock) or 'real' (connect to local Chatwoot Rails backend)
VITE_DATA_MODE=local

# Local Chatwoot backend base URL (default: http://localhost:3000 or custom proxy port)
VITE_CHATWOOT_BASE_URL=http://localhost:3000

# Optional account ID override if profile auto-discovery is not used (default: auto-discovered from /api/v1/profile)
VITE_CHATWOOT_ACCOUNT_ID=
